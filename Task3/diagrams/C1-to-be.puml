Rel(payouts_service, bank_api, "Инициирует выплаты через")


' Межрегиональное взаимодействие (SSO / Roaming пользователей)
Rel(auth_server, auth_server_latam, "Синхронизация учетных данных / OIDC Brokering", "gRPC / mTLS", $tags="new")
Rel(auth_server_latam, auth_server_sea, "Синхронизация учетных данных / OIDC Brokering", "gRPC / mTLS", $tags="new")
