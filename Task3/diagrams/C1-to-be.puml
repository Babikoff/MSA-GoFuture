@startuml Context_Diagram_With_Payouts
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

AddRelTag("new", $lineColor="red",$textColor="red", $lineStyle=SolidLine())
AddSystemTag("new", $bgColor="red", $fontColor="white", $borderColor="red")

Person(passenger, "Пассажир", "Заказывает, отслеживает и оплачивает поездки")
Person(driver, "Водитель", "Принимает заказы, управляет поездками\nи получает выплаты") 
Person(manager, "Корпоративный менеджер", "Управляет корпоративными поездками и счетами")
Person(accountant, "Бухгалтер", "Контролирует выплаты водителям")

System(global_dns, "Global DNS router", "", "Геомаршрутизация к ближайшему региону", $tags="new")
Rel(passenger, global_dns, "Использует для заказа поездок", $tags="new")
Rel(driver, global_dns, "Использует для работы и получения выплат", $tags="new")
Rel(manager, global_dns, "Использует для управления счетами", $tags="new")
Rel(accountant, global_dns, "Контролирует выплаты через", $tags="new")

System_Boundary(booking_service_sys_sea, "GoFuture Microservices Platform - SEA") {
  System(api_gateway_sea, "API Gateway", "Kong или NGINX (маршрутизация, API versioning)")
  System(auth_server_sea, "Auth server", "Keycloak (единиый центр аутентификации)")
  System(user_info_service_sea, "User info service", "Сервис пользователей", $tags="new")
  System(booking_service_sea, "Booking service", "Сервис заказов")
  System(notification_service_sea, "Notification Service", "Сервис нотификаций")
  System(geo_service_sea, "Geography Service", "Гео сервис")
  System(pricing_service_sea, "Pricing Service", "Сервис тарификации")
  System(driver_service_sea, "Driver Service", "Сервис водителей")
  System(payments_service_sea, "Payments Service", "Сервис приёма платежей")
  System(payouts_service_sea, "Payouts Service", "Сервис выплат водителям")
  System(fraud_service_sea, "Fraud Service", "Антифрод сервис (перехватывает нужные данные из Kafka)")
  System(analitics_service_sea, "Analitics Service", "Сервис аналитики (перехватывает нужные данные из Kafka)")

  Rel(global_dns, api_gateway_sea, "", $tags="new")

  BiRel(api_gateway_sea, auth_server_sea, "Аутентификация")

  Rel(api_gateway_sea, booking_service_sea, "REST")
  Rel(api_gateway_sea, geo_service_sea, "REST")
  Rel(api_gateway_sea, pricing_service_sea, "REST")
  Rel(api_gateway_sea, driver_service_sea, "REST")
  Rel(api_gateway_sea, payments_service_sea, "REST")
  Rel(api_gateway_sea, payouts_service_sea, "REST")

  ' Нотификации
  Rel(booking_service_sea, notification_service_sea, "Нотификации")
  Rel(driver_service_sea, notification_service_sea, "Нотификации")
  Rel(payments_service_sea, notification_service_sea, "Нотификации")

  ' Оркестрация
  Rel(booking_service_sea, geo_service_sea, "Ищет маршрут")
  Rel(booking_service_sea, pricing_service_sea, "Запрашивает цену")
  Rel(booking_service_sea, payments_service_sea, "Инициирует платёж")
  Rel(booking_service_sea, driver_service_sea, "Назначает водителя")
  Rel(booking_service_sea, user_info_service_sea, "Получает информацию о пользователе", $tags="new")

  ' Взаимодействия вне оркестрации
  Rel(driver_service_sea, payouts_service_sea, "Исполнение заказа")
}

